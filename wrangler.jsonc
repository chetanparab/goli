// The goli website (site/) on Cloudflare Workers static assets.
// Deployed by the maintainer from their machine (CI only checks site/);
// served at goli.theanalogyarchitect.com.
{
  "name": "goli",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "goli.theanalogyarchitect.com", "custom_domain": true }],
  "workers_dev": false, // served only on the custom domain
  "preview_urls": false,
  "observability": { "enabled": false }
}
